[user]
	name       = eric_huang
	email      = godhand4826@gmail.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEx7LgGcv6z0mtZAqqqHHAkS92AH+Eiij5C6kmr54kJP
[core]
	editor     = vim
    pager      = less -F -X
[alias]
	a          = add
	aa         = add --all
	co         = checkout
	d          = diff
	dc         = diff --cached
	l          = log --graph --oneline       -n 20
	ll         = log --graph --oneline --all -n 20
	lll        = log --graph --oneline --all
	ru         = remote update --prune
	st         = status
	su         = submodule update --recursive --init
[diff]
	tool       = vimdiff
[difftool]
	prompt     = false
[gpg]
	format     = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
